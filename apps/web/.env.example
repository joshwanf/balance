# Postgres connection used by Prisma
DATABASE_URL_SCHEMA="postgresql://user@localhost:5432/db?schema=balance"
# Required: the app refuses to start without it
JWT_SECRET=
# Token lifetime in seconds (defaults to one week)
JWT_EXPIRES_IN=604800

# Plaid (optional: bank linking is hidden when these are unset)
PLAID_CLIENT_ID=
# Used for the demo user, and for everyone while PLAID_ENV=sandbox
PLAID_SECRET_SANDBOX=
# Only needed when PLAID_ENV=production
PLAID_SECRET_PRODUCTION=
# Environment for new links by real users: sandbox or production
PLAID_ENV=sandbox
# Public URL of /api/plaid/webhook (use a tunnel such as ngrok locally)
PLAID_WEBHOOK_URL=
# 32 random bytes, base64. Generate with: openssl rand -base64 32
PLAID_TOKEN_KEY=
