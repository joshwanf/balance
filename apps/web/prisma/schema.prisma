// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_SCHEMA")
}

model User {
  id             String  @id @db.Uuid
  email          String  @unique
  username       String  @unique
  firstName      String
  lastName       String
  hashedPassword String
  isDemo         Boolean @default(false)

  accounts      Account[]
  transactions  Transaction[]
  categories    Category[]
  CategoryMonth CategoryMonth[]
  Tags          Tags[]
  plaidItems    PlaidItem[]

  @@index(fields: [email])
  @@index(fields: [username])
}

model Account {
  id          String @id @db.Uuid
  name        String
  cleanedName String
  accountType String // checking, credit

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  // Set for accounts linked through Plaid; null for manual accounts
  plaidItemId    String?    @db.Uuid
  plaidItem      PlaidItem? @relation(fields: [plaidItemId], references: [id], onDelete: SetNull)
  plaidAccountId String?    @unique
  mask           String? // last 4 digits of the bank account number

  @@index(fields: [userId, cleanedName])
}

model Transaction {
  id     String @id @db.Uuid
  type   String // outgoing or incoming
  payee  String
  amount Int    @db.Integer
  date   String

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  categoryId String?              @db.Uuid
  category   Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       TransactionsOnTags[]

  // Who created the row: "manual" or "plaid". A Plaid merge never changes it
  source             String  @default("manual")
  plaidTransactionId String? @unique
  pending            Boolean @default(false)
  merchantName       String?

  // Set by sync when this imported row may duplicate a manual one
  possibleDuplicateOfId String?       @db.Uuid
  possibleDuplicateOf   Transaction?  @relation("PossibleDuplicate", fields: [possibleDuplicateOfId], references: [id], onDelete: SetNull)
  possibleDuplicates    Transaction[] @relation("PossibleDuplicate")
}

model Category {
  id          String @unique @db.Uuid
  name        String
  cleanedName String

  userId        String          @db.Uuid
  user          User            @relation(fields: [userId], references: [id])
  transactions  Transaction[]
  CategoryMonth CategoryMonth[]

  @@id(fields: [userId, cleanedName])
  @@index(fields: [userId, cleanedName])
}

model CategoryMonth {
  id     String @unique @db.Uuid
  month  String
  amount Int    @db.Integer

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id(fields: [userId, categoryId, month])
  @@index(fields: [userId, categoryId, month])
}

model Tags {
  id          String @id @db.Uuid
  name        String
  cleanedName String

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  transactions TransactionsOnTags[]

  @@unique(fields: [userId, cleanedName])
  // @@id(fields: [userId, cleanedName])
  @@index(fields: [userId, cleanedName])
}

model TransactionsOnTags {
  transactionId String      @db.Uuid
  transactions  Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  tagId String @db.Uuid
  tags  Tags   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
}

/// One bank connection made through Plaid Link (or the sandbox, for the demo user)
model PlaidItem {
  id              String    @id @db.Uuid
  plaidItemId     String    @unique // Plaid's item_id; webhooks are routed by it
  accessToken     String // AES-256-GCM ciphertext, see server/plaid/crypto.ts
  environment     String // "sandbox" | "production"
  institutionId   String?
  institutionName String?
  cursor          String? // last next_cursor from /transactions/sync
  status          String    @default("active") // active | login_required | error | revoked
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accounts Account[]

  @@index(fields: [userId])
}
