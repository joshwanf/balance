{
  "name": "balance",
  "author": "Joshua Wang",
  "license": "MIT",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install-backend": "yarn --cwd backend install",
    "install-frontend": "yarn --cwd frontend install",
    "install": "yarn install-frontend && yarn install-backend",
    "build": "yarn --cwd frontend build && yarn --cwd backend build",
    "dev:web": "yarn workspace @balance/web dev",
    "build:web": "yarn workspace @balance/web build"
  }
}
